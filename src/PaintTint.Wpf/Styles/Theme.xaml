<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="WindowBackgroundColor">#0F172A</Color>
    <Color x:Key="CardBackgroundColor">#1E293B</Color>
    <Color x:Key="CardBorderColor">#334155</Color>
    <Color x:Key="CardHoverBorderColor">#475569</Color>
    <Color x:Key="InputBackgroundColor">#0F172A</Color>
    <Color x:Key="InputBorderColor">#475569</Color>
    <Color x:Key="InputFocusBorderColor">#3B82F6</Color>

    <Color x:Key="PrimaryAccentColor">#2563EB</Color>
    <Color x:Key="PrimaryAccentHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryAccentPressedColor">#1E40AF</Color>
    <Color x:Key="PrimaryAccentDisabledColor">#334155</Color>

    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextDisabledColor">#475569</Color>

    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorBackgroundColor">#451A1A</Color>
    <Color x:Key="ErrorBorderColor">#991B1B</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}" />

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentPressedBrush" Color="{StaticResource PrimaryAccentPressedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentDisabledBrush" Color="{StaticResource PrimaryAccentDisabledColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#334155" />
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="#172554" />
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#172033" />
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#064E3B" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#88000000" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#AA000000" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}" />

